{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hand Landmark Payload",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "hand_data"
    },
    "source": {
      "type": "string",
      "enum": ["mediapipe", "glove"]
    },
    "hand": {
      "type": "string",
      "enum": ["left", "right"]
    },
    "sessionId": {
      "type": "string",
      "description": "Session ID for routing hand data to the correct session room"
    },
    "timestamp": {
      "type": "number",
      "description": "Milliseconds since epoch"
    },
    "landmarks": {
      "type": "array",
      "description": "21 3D points representing the hand joints",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        },
        "required": ["x", "y", "z"],
        "additionalProperties": false
      },
      "minItems": 21,
      "maxItems": 21
    }
  },
  "required": ["type", "source", "hand", "timestamp", "landmarks"],
  "additionalProperties": false
}