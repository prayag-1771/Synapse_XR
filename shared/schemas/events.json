{
  "events": {
    "hand:data": {
      "direction": "expert->server->worker",
      "payload": {
        "type": "hand_data"
      }
    },

    "gesture:detected": {
      "direction": "expert->server->worker",
      "payload": {
        "gesture": "string",
        "confidence": "number"
      }
    },

    "voice:transcript": {
      "direction": "expert->server->worker",
      "payload": {
        "text": "string",
        "timestamp": "number"
      }
    },

    "annotation:update": {
      "direction": "expert->server->worker",
      "payload": {
        "text": "string",
        "x": "number",
        "y": "number",
        "timestamp": "number"
      }
    },

    "ai:detection": {
      "direction": "worker->server->expert",
      "payload": {
        "objects": [
          {
            "label": "string",
            "confidence": "number",
            "bbox": [0, 0, 0, 0]
          }
        ],
        "alerts": ["string"]
      }
    },

    "ai:step-validation": {
      "direction": "worker->server->expert",
      "payload": {
        "currentStep": "number",
        "passed": "boolean",
        "message": "string",
        "detectedCounts": {
          "plc": "number",
          "relay": "number",
          "motor": "number",
          "push_button": "number",
          "wire": "number"
        }
      }
    },

    "session:join": {
      "direction": "client->server",
      "payload": {
        "sessionId": "string",
        "userId": "string",
        "role": "expert | worker"
      }
    },

    "session:end": {
      "direction": "client->server->client",
      "payload": {
        "sessionId": "string",
        "reason": "string"
      }
    },

    "webrtc:offer": {
      "direction": "peer->server->peer",
      "payload": {
        "sdp": "string"
      }
    },

    "webrtc:answer": {
      "direction": "peer->server->peer",
      "payload": {
        "sdp": "string"
      }
    },

    "webrtc:ice": {
      "direction": "peer->server->peer",
      "payload": {
        "candidate": "string"
      }
    }
  }
}